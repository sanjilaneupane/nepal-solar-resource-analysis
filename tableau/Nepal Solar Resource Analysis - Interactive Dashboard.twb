    <worksheet name='Zone Trend'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontname='Tableau Bold'>Zone Trend</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='nepal_districts_lookup' name='federated.17kp1x81lw3qgu147u8mh1ry096x' />
          </datasources>
          <datasource-dependencies datasource='federated.17kp1x81lw3qgu147u8mh1ry096x'>
            <column caption='Pct change from 2005' datatype='real' name='[Calculation_1105581300322305]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([GHI_annual]) - LOOKUP(SUM([GHI_annual]), FIRST())) / LOOKUP(SUM([GHI_annual]), FIRST())'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='GHI annual' datatype='real' name='[GHI_annual]' role='measure' type='quantitative' />
            <column-instance column='[year]' derivation='None' name='[none:year:qk]' pivot='key' type='quantitative' />
