    "# ================================================================\n",
    "# SCENARIO A - EQUITY IRR UNDER TROUGH STRESS\n",
    "# Pre-tax, no depreciation shield. Project life 25 years (standard\n",
    "# operating-life assumption). Debt service stops at Year 12.\n",
    "# ================================================================\n",
    "\n",
    "PROJECT_LIFE_YRS = 25\n",
    "\n",
    "def calc_irr(cashflows, lo=-0.5, hi=1.0, tol=1e-6, max_iter=200):\n",
    "    def npv(rate):\n",
    "        return sum(cf / (1 + rate) ** t for t, cf in enumerate(cashflows))\n",
    "    f_lo, f_hi = npv(lo), npv(hi)\n",
    "    if f_lo * f_hi > 0:\n",
    "        return None\n",
    "    for _ in range(max_iter):\n",
    "        mid = (lo + hi) / 2\n",
    "        f_mid = npv(mid)\n",
    "        if abs(f_mid) < tol:\n",
    "            return mid\n",
    "        if f_lo * f_mid < 0:\n",
    "            hi, f_hi = mid, f_mid\n",
    "        else:\n",
    "            lo, f_lo = mid, f_mid\n",
    "    return mid\n",
    "\n",
    "def equity_irr(capex_per_mw, tariff, debt_ratio, interest_rate, loan_term, ghi,\n",
    "                capacity_mw=10.0, ilr=1.25, perf_ratio=0.82, degradation=0.005, opex=0.80):\n",
    "    capex_npr = capacity_mw * capex_per_mw\n",
    "    debt_npr  = capex_npr * debt_ratio\n",
    "    equity_npr = capex_npr - debt_npr\n",
    "    r, n = interest_rate, loan_term\n",
    "    annual_ds = debt_npr * (r * (1 + r) ** n) / ((1 + r) ** n - 1)\n",
    "    cashflows = [-equity_npr]\n",
    "    for yr in range(1, PROJECT_LIFE_YRS + 1):\n",
    "        deg = (1 - degradation) ** (yr - 1)\n",
    "        kwh = (capacity_mw * ilr) * ghi * perf_ratio * deg * 1000\n",
    "        noi = kwh * (tariff - opex)\n",
    "        ds  = annual_ds if yr <= loan_term else 0\n",
    "        cashflows.append(noi - ds)\n",
    "    return calc_irr(cashflows)\n",
    "\n",
    "print(\"Scenario A - Equity IRR | NPR 7.30/kWh | 75% debt | 9% | 12-yr debt term | 25-yr life\\n\")\n",
    "for capex_label, capex_per_mw in [(\"NPR 80M/MW\", 80_000_000), (\"NPR 85M/MW\", 85_000_000)]:\n",
    "    print(capex_label)\n",
    "    for g_label, ghi in [(\"P50\", GHI_P50), (\"Trough avg (2015-2021)\", GHI_TROUGH),\n",
    "                          (\"Worst year (2020-2021)\", GHI_WORST)]:\n",
    "        irr = equity_irr(capex_per_mw, 7.30, 0.75, 0.09, 12, ghi)\n",
    "        irr_str = f\"{irr*100:.1f}%\" if irr is not None else \"not solvable\"\n",
    "        print(f\"  {g_label:<26} Equity IRR: {irr_str}\")\n",
    "    print()"
   ]
