   "source": [
    "# ================================================================\n",
    "# MONTHLY / QUARTERLY MINIMUM-DSCR STRESS TEST\n",
    "# Scenario B basis. Year 1, no degradation. Level monthly debt\n",
    "# service assumed (ANNUAL_DS / 12).\n",
    "# ================================================================\n",
    "\n",
    "CAPACITY_MW_AC, ILR, PERF_RATIO = 10.0, 1.25, 0.82\n",
    "CAPEX_NPR_PER_MW, TARIFF_NPR_PER_KWH = 75_000_000, 5.94\n",
    "INTEREST_RATE, DEBT_RATIO, LOAN_TERM_YRS = 0.09, 0.75, 15\n",
    "OPEX_NPR_PER_KWH, DSCR_COVENANT = 0.80, 1.20\n",
    "\n",
    "DC_MWP    = CAPACITY_MW_AC * ILR\n",
    "CAPEX_NPR = CAPACITY_MW_AC * CAPEX_NPR_PER_MW\n",
    "DEBT_NPR  = CAPEX_NPR * DEBT_RATIO\n",
    "r, n      = INTEREST_RATE, LOAN_TERM_YRS\n",
    "ANNUAL_DS = DEBT_NPR * (r * (1 + r)**n) / ((1 + r)**n - 1)\n",
    "MONTHLY_DS = ANNUAL_DS / 12\n",
    "\n",
    "df_sys_monthly = df_all_77.groupby(['year', 'month'])['H(h)_m'].mean().reset_index()\n",
    "monthly_stats = df_sys_monthly.groupby('month')['H(h)_m'].agg(ghi_mean='mean', ghi_std='std').reset_index()\n",
    "monthly_stats['cov_pct'] = monthly_stats['ghi_std'] / monthly_stats['ghi_mean'] * 100\n",
    "monthly_stats['ghi_P10'] = monthly_stats['ghi_mean'] - 1.282 * monthly_stats['ghi_std']\n",
    "\n",
    "month_labels = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec']\n",
    "\n",
    "def month_dscr(ghi_month):\n",
    "    kwh = DC_MWP * ghi_month * PERF_RATIO * 1000\n",
    "    noi = kwh * (TARIFF_NPR_PER_KWH - OPEX_NPR_PER_KWH)\n",
    "    return noi / MONTHLY_DS\n",
    "\n",
    "monthly_stats['DSCR_P50'] = monthly_stats['ghi_mean'].apply(month_dscr)\n",
    "monthly_stats['DSCR_P10'] = monthly_stats['ghi_P10'].apply(month_dscr)\n",
    "\n",
    "print(\"Monthly Minimum-DSCR Stress Test | System-wide, 77 districts | Year 1\\n\")\n",
    "print(f\"{'Month':<6} {'GHI P50':>9} {'GHI P10':>9} {'DSCR P50':>9} {'DSCR P10':>9}  Status (P10)\")\n",
    "print(\"-\" * 60)\n",
    "for i, row in monthly_stats.iterrows():\n",
    "    s = \"OK\" if row['DSCR_P10'] >= DSCR_COVENANT else (\"Below covenant\" if row['DSCR_P10'] >= 1.0 else \"DEFAULT RISK\")\n",
    "    print(f\"{month_labels[i]:<6} {row['ghi_mean']:>9.0f} {row['ghi_P10']:>9.0f} \"\n",
    "          f\"{row['DSCR_P50']:>9.3f} {row['DSCR_P10']:>9.3f}  {s}\")\n",
    "\n",
    "worst = monthly_stats.loc[monthly_stats['DSCR_P10'].idxmin()]\n",
    "print(f\"\\nWeakest month (P10 stress): {month_labels[int(worst['month'])-1]} | DSCR {worst['DSCR_P10']:.3f}\")\n",
    "\n",
    "print(\"\\nQuarterly DSCR (P10 stress, 3-month rolling)\")\n",
    "quarters = {'Q1 Jan-Mar': [0,1,2], 'Q2 Apr-Jun': [3,4,5], 'Q3 Jul-Sep': [6,7,8], 'Q4 Oct-Dec': [9,10,11]}\n",
    "for q_label, idxs in quarters.items():\n",
    "    kwh_q = sum(DC_MWP * monthly_stats.iloc[i]['ghi_P10'] * PERF_RATIO * 1000 for i in idxs)\n",
    "    noi_q = kwh_q * (TARIFF_NPR_PER_KWH - OPEX_NPR_PER_KWH)\n",
    "    dscr_q = noi_q / (MONTHLY_DS * 3)\n",
    "    s = \"OK\" if dscr_q >= DSCR_COVENANT else (\"Below covenant\" if dscr_q >= 1.0 else \"DEFAULT RISK\")\n",
    "    print(f\"  {q_label:<12} DSCR: {dscr_q:.3f}  {s}\")"
   ]
