    "# ================================================================\n",
    "# SCENARIO A: GENERATION-1 PROJECTS - NPR 7.30 TARIFF ERA\n",
    "# Representative of first-generation Nepal utility solar (~2020-2022)\n",
    "# CAPEX sensitivity: NPR 80M/MW and NPR 85M/MW, bracketing the range\n",
    "#        typically observed for 10 MW utility-scale solar in Nepal\n",
    "#        during this period.\n",
    "# Tariff: NPR 7.30/kWh (PPA rate prior to 2022 revision)\n",
    "# ================================================================\n",
    "\n",
    "CAPACITY_MW_AC    = 10.0\n",
    "ILR               = 1.25\n",
    "PERF_RATIO        = 0.82\n",
    "DEGRADATION_RATE  = 0.005\n",
    "TARIFF_NPR_PER_KWH = 7.30\n",
    "INTEREST_RATE     = 0.09\n",
    "DEBT_RATIO        = 0.75\n",
    "LOAN_TERM_YRS     = 12\n",
    "OPEX_NPR_PER_KWH  = 0.80\n",
    "DSCR_COVENANT     = 1.20\n",
    "DSCR_DEFAULT      = 1.00\n",
    "\n",
    "GHI_P50      = df_yr_avg['ghi'].mean()\n",
    "GHI_TROUGH   = df_yr_avg[(df_yr_avg['year'] >= 2015) &\n",
    "                          (df_yr_avg['year'] <= 2021)]['ghi'].mean()\n",
    "GHI_WORST    = df_yr_avg[df_yr_avg['year'].isin([2020, 2021])]['ghi'].mean()\n",
    "\n",
    "print(f\"\\n  Resource scenarios derived from PVGIS ERA5 (2005-2023):\")\n",
    "print(f\"    P50 (long-run mean):          {GHI_P50:.0f} kWh/m²/yr\")\n",
    "print(f\"    Trough avg (2015-2021):       {GHI_TROUGH:.0f} kWh/m²/yr\")\n",
    "print(f\"    Worst year avg (2020-2021):   {GHI_WORST:.0f} kWh/m²/yr\")\n",
    "\n",
    "def status(d):\n",
    "    if d >= DSCR_COVENANT:  return \"OK\"\n",
    "    if d >= DSCR_DEFAULT:   return \"Below covenant\"\n",
    "    return \"DEFAULT RISK\"\n",
    "\n",
    "def dscr_a(ghi, proj_yr, annual_ds):\n",
    "    deg = (1 - DEGRADATION_RATE) ** (proj_yr - 1)\n",
    "    kwh = (CAPACITY_MW_AC * ILR) * ghi * PERF_RATIO * deg * 1000\n",
    "    noi = kwh * (TARIFF_NPR_PER_KWH - OPEX_NPR_PER_KWH)\n",
    "    return noi / annual_ds\n",
    "\n",
    "resource_cases = [\n",
    "    (\"P50 (2005-2023 mean)\",        GHI_P50),\n",
    "    (\"Trough avg (2015-2021)\",      GHI_TROUGH),\n",
    "    (\"Worst year (2020-2021 avg)\",  GHI_WORST),\n",
    "]\n",
    "\n",
    "capex_cases = [\n",
    "    (\"NPR 80M/MW\", 80_000_000),\n",
    "    (\"NPR 85M/MW\", 85_000_000),\n",
    "]\n",
    "\n",
    "print(\"Scenario A - Generation-1 Solar | NPR 7.30/kWh | 75% debt | 9% | 12-yr\")\n",
    "print(\"CAPEX sensitivity: NPR 80M/MW vs NPR 85M/MW\\n\")\n",
    "\n",
    "for capex_label, capex_per_mw in capex_cases:\n",
    "    capex_npr = CAPACITY_MW_AC * capex_per_mw\n",
    "    debt_npr  = capex_npr * DEBT_RATIO\n",
    "    r, n      = INTEREST_RATE, LOAN_TERM_YRS\n",
    "    annual_ds = debt_npr * (r * (1 + r)**n) / ((1 + r)**n - 1)\n",
    "\n",
    "    print(f\"{'='*64}\")\n",
    "    print(f\"  {capex_label}\")\n",
    "    print(f\"{'='*64}\")\n",
    "    print(f\"  CAPEX:               NPR {capex_npr/1e7:.1f} Crore\")\n",
    "    print(f\"  Debt (75%):          NPR {debt_npr/1e7:.1f} Crore\")\n",
    "    print(f\"  Annual debt service: NPR {annual_ds/1e7:.2f} Crore/yr\")\n",
    "\n",
    "    for proj_yr, yr_label in [(1, \"Year 1 - project start\"),\n",
    "                               (5, \"Year 5 - degradation -2%\"),\n",
    "                               (10, \"Year 10 - degradation -5%\")]:\n",
    "        print(f\"\\n  {yr_label}\")\n",
    "        print(f\"  {'Resource':<28} {'DSCR':>6}  Status\")\n",
    "        print(f\"  {'─'*48}\")\n",
    "        for g_label, ghi in resource_cases:\n",
    "            d = dscr_a(ghi, proj_yr, annual_ds)\n",
    "            print(f\"  {g_label:<28} {d:>6.3f}  {status(d)}\")\n",
    "    print()"
   ]
