   "source": [
    "# --- EMPIRICAL vs PARAMETRIC P90 COMPARISON ---\n",
    "# Parametric P90 (above) assumes a normal distribution. With 19 years of\n",
    "# data in a monsoonal climate, that assumption is untested. This computes\n",
    "# the empirical 10th percentile directly from the observed annual series\n",
    "# per district and compares it against the parametric figure. Where the\n",
    "# empirical value is materially lower, the normal-distribution assumption\n",
    "# is understating tail risk and the empirical figure should be used as\n",
    "# the conservative DSCR basis instead.\n",
    "\n",
    "empirical_rows = []\n",
    "for location in df_yearly_trend_77['location'].unique():\n",
    "    df_loc = df_yearly_trend_77[df_yearly_trend_77['location'] == location]\n",
    "    zone = df_loc['zone'].values[0]\n",
    "    ghi_series = df_loc['GHI_annual'].values\n",
    "    p50_emp = np.percentile(ghi_series, 50)\n",
    "    p90_emp = np.percentile(ghi_series, 10)  # 10th percentile = P90 exceedance\n",
    "    empirical_rows.append({'location': location, 'zone': zone,\n",
    "                            'P50_empirical': round(p50_emp, 1),\n",
    "                            'P90_empirical': round(p90_emp, 1)})\n",
    "\n",
    "df_p90_empirical = pd.DataFrame(empirical_rows)\n",
    "df_compare = df_p90_77[['location', 'P50', 'P90']].merge(df_p90_empirical, on='location')\n",
    "df_compare['P90_gap'] = df_compare['P90_empirical'] - df_compare['P90']\n",
    "df_compare['P90_gap_pct'] = (df_compare['P90_gap'] / df_compare['P90']) * 100\n",
    "df_compare = df_compare.sort_values('P90_gap_pct')\n",
    "df_compare.to_csv('nepal_ghi_p90_empirical_vs_parametric_77.csv', index=False)\n",
    "\n",
    "n_lower = (df_compare['P90_gap'] < 0).sum()\n",
    "print(f\"Districts where empirical P90 is lower than parametric P90 (tail risk understated): {n_lower} of 77\")\n",
    "print(f\"Average gap (empirical minus parametric): {df_compare['P90_gap_pct'].mean():.2f}%\")\n",
    "print(f\"\\nLargest negative gaps (parametric most overstates the P90 floor):\")\n",
    "print(df_compare[['location', 'zone', 'P90', 'P90_empirical', 'P90_gap_pct']].head(10).to_string(index=False))"
   ]
