    "### Bootstrap Confidence Interval: Trough Depth\n",
    "   Resamples the 2015-2021 annual values 2,000 times to put a confidence interval\n",
    "   on the trough depth reported above, rather than relying on a single point estimate."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 43,
   "id": "d159bf85-d238-4f82-9d78-3768888bc73c",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "System-wide trough depth vs 2005 baseline (2015-2021 mean):\n",
      "  Point estimate:  -5.6%\n",
      "  95% CI:          -7.1% to -4.3%\n",
      "  Bootstrap n:     2000 iterations\n"
     ]
    }
   ],
   "source": [
    "# --- BOOTSTRAP CONFIDENCE INTERVAL: TROUGH DEPTH ---\n",
    "# Resamples 2015-2021 annual values with replacement 2000 times.\n",
    "# Reports 95% CI on the mean trough depth vs 2005 baseline.\n",
    "\n",
    "rng = np.random.default_rng(42)\n",
    "\n",
    "system_yr = (df_yearly_trend_77.groupby('year')['GHI_annual'].mean()\n",
    "             .reset_index().rename(columns={'GHI_annual': 'ghi'}))\n",
    "baseline_2005 = system_yr.loc[system_yr['year'] == 2005, 'ghi'].values[0]\n",
    "\n",
    "trough_pct = system_yr.loc[\n",
    "    (system_yr['year'] >= 2015) & (system_yr['year'] <= 2021), 'ghi']\n",
    "trough_pct_vals = ((trough_pct.values - baseline_2005) / baseline_2005) * 100\n",
    "\n",
    "n_iter = 2000\n",
    "boots = np.array([\n",
    "    rng.choice(trough_pct_vals, len(trough_pct_vals), replace=True).mean()\n",
    "    for _ in range(n_iter)\n",
    "])\n",
    "\n",
    "mean_depth = trough_pct_vals.mean()\n",
    "ci_lo, ci_hi = np.percentile(boots, 2.5), np.percentile(boots, 97.5)\n",
    "\n",
    "print(f\"System-wide trough depth vs 2005 baseline (2015-2021 mean):\")\n",
    "print(f\"  Point estimate:  {mean_depth:.1f}%\")\n",
    "print(f\"  95% CI:          {ci_lo:.1f}% to {ci_hi:.1f}%\")\n",
    "print(f\"  Bootstrap n:     {n_iter} iterations\")"
   ]
  },
