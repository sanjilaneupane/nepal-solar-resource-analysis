   "source": [
    "# --- ZONE-LEVEL SUMMARY TABLE ---\n",
    "# Aggregates all key metrics by zone\n",
    "# Single reference table for lenders, developers, and researchers\n",
    "\n",
    "zone_summary = df_yearly_trend_77.groupby('zone').agg(\n",
    "    districts=('location', 'nunique'),\n",
    "    ghi_mean=('GHI_annual', 'mean'),\n",
    ").reset_index()\n",
    "\n",
    "# Net change by zone\n",
    "zone_net_change = df_scenarios.groupby('zone').agg(\n",
    "    net_change_mean=('base_pct', 'mean'),\n",
    "    downside_mean=('downside_pct', 'mean'),\n",
    ").reset_index()\n",
    "\n",
    "# CoV by zone\n",
    "zone_cov = df_variability_77.groupby('zone').agg(\n",
    "    cov_mean=('cov_pct', 'mean'),\n",
    ").reset_index()\n",
    "\n",
    "# P90/P50 by zone\n",
    "zone_p90 = df_p90_77.groupby('zone').agg(\n",
    "    p90_p50_mean=('P90_P50_ratio', 'mean'),\n",
    ").reset_index()\n",
    "\n",
    "# Trough risk by zone\n",
    "zone_trough = df_trough.groupby('zone').agg(\n",
    "    max_consec_mean=('max_consecutive', 'mean'),\n",
    "    high_risk_count=('risk_tier', lambda x: (x == 'High').sum()),\n",
    ").reset_index()\n",
    "\n",
    "# Merge all\n",
    "df_zone_summary = zone_summary \\\n",
    "    .merge(zone_net_change, on='zone') \\\n",
    "    .merge(zone_cov, on='zone') \\\n",
    "    .merge(zone_p90, on='zone') \\\n",
    "    .merge(zone_trough, on='zone') \\\n",
    "    .sort_values('ghi_mean', ascending=False)\n",
