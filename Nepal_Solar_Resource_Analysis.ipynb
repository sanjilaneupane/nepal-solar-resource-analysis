    "# --- SCENARIO ANALYSIS ---\n",
    "# Three forward resource scenarios derived from observed 2005-2023 data\n",
    "\n",
    "scenario_data = []\n",
    "\n",
    "for location in df_yearly_trend_77['location'].unique():\n",
    "    df_loc = df_yearly_trend_77[df_yearly_trend_77['location'] == location].copy()\n",
    "    zone = df_loc['zone'].values[0]\n",
    "    ghi_mean = df_loc['GHI_annual'].mean()\n",
    "\n",
    "    # Base case: post-recovery average (2022-2023, non-overlapping with the trough)\n",
    "    ghi_base = df_loc[df_loc['year'] >= 2022]['GHI_annual'].mean()\n",
    "\n",
    "    # Downside case: trough period average (2015-2021)\n",
    "    ghi_downside = df_loc[\n",
    "        (df_loc['year'] >= 2015) & (df_loc['year'] <= 2021)\n",
    "    ]['GHI_annual'].mean()\n",
    "\n",
    "    # Stress case: linear regression extrapolated to 2038 (illustrative\n",
    "    # sensitivity, not a forecast -- see markdown note above this cell)\n",
    "    slope, intercept, _, _, _ = sp_stats.linregress(\n",
    "        df_loc['year'], df_loc['GHI_annual']\n",
    "    )\n",
    "    ghi_stress = intercept + slope * 2038\n",
    "    ghi_stress = max(ghi_stress, ghi_mean * 0.80)\n",
    "\n",
    "    base_pct     = (ghi_base / ghi_mean) * 100\n",
    "    downside_pct = (ghi_downside / ghi_mean) * 100\n",
    "    stress_pct   = (ghi_stress / ghi_mean) * 100\n",
    "\n",
    "    scenario_data.append({\n",
    "        'district':           location,\n",
    "        'zone':               zone,\n",
    "        'ghi_longrun_mean':   round(ghi_mean, 1),\n",
    "        'ghi_base':           round(ghi_base, 1),\n",
    "        'ghi_downside':       round(ghi_downside, 1),\n",
    "        'ghi_stress':         round(ghi_stress, 1),\n",
    "        'base_pct':           round(base_pct, 1),\n",
    "        'downside_pct':       round(downside_pct, 1),\n",
    "        'stress_pct':         round(stress_pct, 1),\n",
    "    })\n",
    "\n",
    "df_scenarios = pd.DataFrame(scenario_data).sort_values(\n",
    "    'downside_pct', ascending=True\n",
    ")\n",
    "df_scenarios.to_csv('nepal_ghi_scenarios_77.csv', index=False)\n",
    "\n",
    "print(\"Resource Scenarios by District (as % of long-run mean)\")\n",
    "print(f\"\\n{'District':<20} {'Zone':<22} {'Base%':>7} {'Down%':>7} {'Stress%':>8}\")\n",
    "print(\"-\" * 70)\n",
    "for _, row in df_scenarios.iterrows():\n",
    "    print(f\"{row['district']:<20} {row['zone']:<22} \"\n",
    "          f\"{row['base_pct']:>7.1f} {row['downside_pct']:>7.1f} \"\n",
    "          f\"{row['stress_pct']:>8.1f}\")\n",
    "\n",
    "print(f\"\\nAverage across 77 districts (long-run mean basis, 2005-2023):\")\n",
    "print(f\"  Base case (2022-2023, non-overlapping with trough): {df_scenarios['base_pct'].mean():.1f}% of long-run mean\")\n",
    "print(f\"  Downside case (2015-2021 trough):                    {df_scenarios['downside_pct'].mean():.1f}% of long-run mean\")\n",
    "print(f\"  Stress case (2038 linear extrapolation):             {df_scenarios['stress_pct'].mean():.1f}% of long-run mean\")\n",
    "print(f\"  Gap, base minus downside: {df_scenarios['base_pct'].mean() - df_scenarios['downside_pct'].mean():.1f} percentage points\")"
