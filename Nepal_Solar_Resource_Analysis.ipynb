   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Lag-1 autocorrelation of annual GHI deviations: 0.121\n",
      "(0 = independent draws | positive = persistence, supports a multi-year trough effect)\n",
      "\n",
      "Wald-Wolfowitz runs test: observed runs 9 | expected 9.8 | z -0.43 | p 0.668\n",
      "p < 0.05 means the above/below-mean years are not randomly ordered.\n",
      "\n",
      "Observed longest consecutive below-mean run: 8 years\n",
      "\n",
      "Permutation test (10,000 shuffles): P(a run of 8+ years by chance) = 0.0493\n",
      "Mean simulated longest run under random ordering: 4.81 years\n"
     ]
    }
   ],
   "source": [
    "#Autocorrelation and permutation runs test on the 2015-2021 trough\n",
    "\n",
    "\n",
    "df_yr_avg_ac = (df_yearly_trend_77.groupby('year')['GHI_annual'].mean()\n",
    "                 .reset_index().rename(columns={'GHI_annual': 'ghi'}).sort_values('year').reset_index(drop=True))\n",
    "series = df_yr_avg_ac['ghi'].values\n",
    "mean_ghi = series.mean()\n",
    "deviations = series - mean_ghi\n",
    "\n",
    "lag1 = np.corrcoef(deviations[:-1], deviations[1:])[0, 1]\n",
    "print(f\"Lag-1 autocorrelation of annual GHI deviations: {lag1:.3f}\")\n",
    "print(\"(0 = independent draws | positive = persistence, supports a multi-year trough effect)\\n\")\n",
    "\n",
    "below_mean = (series < mean_ghi).astype(int)\n",
    "n1, n2 = below_mean.sum(), len(below_mean) - below_mean.sum()\n",
    "runs = 1 + (below_mean[1:] != below_mean[:-1]).sum()\n",
    "expected_runs = (2*n1*n2)/(n1+n2) + 1\n",
    "var_runs = (2*n1*n2*(2*n1*n2-n1-n2)) / (((n1+n2)**2)*(n1+n2-1))\n",
    "z_runs = (runs - expected_runs) / np.sqrt(var_runs)\n",
    "p_runs = 2 * (1 - sp_stats.norm.cdf(abs(z_runs)))\n",
    "print(f\"Wald-Wolfowitz runs test: observed runs {runs} | expected {expected_runs:.1f} | z {z_runs:.2f} | p {p_runs:.3f}\")\n",
    "print(\"p < 0.05 means the above/below-mean years are not randomly ordered.\\n\")\n",
    "\n",
    "def max_run_length(b):\n",
    "    m=c=0\n",
    "    for v in b:\n",
    "        if v: c+=1; m=max(m,c)\n",
    "        else: c=0\n",
    "    return m\n",
    "\n",
    "observed_max_run = max_run_length(below_mean)\n",
    "print(f\"Observed longest consecutive below-mean run: {observed_max_run} years\\n\")\n",
    "\n",
    "np.random.seed(42)\n",
    "sim_max_runs = np.array([max_run_length(np.random.permutation(below_mean)) for _ in range(10000)])\n",
    "p_perm = (sim_max_runs >= observed_max_run).mean()\n",
    "print(f\"Permutation test (10,000 shuffles): P(a run of {observed_max_run}+ years by chance) = {p_perm:.4f}\")\n",
    "print(f\"Mean simulated longest run under random ordering: {sim_max_runs.mean():.2f} years\")"
   ]
  },
