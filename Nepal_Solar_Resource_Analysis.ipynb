  {
   "cell_type": "code",
   "execution_count": 37,
   "id": "4f6bffdf",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Exported 145 rows to nepal_dscr_full_77.csv\n",
      "scenario_name\n",
      "Scenario B - Grid    66\n",
      "Scenario B           36\n",
      "Scenario A - Grid    25\n",
      "Scenario A           18\n",
      "Name: count, dtype: int64\n"
     ]
    }
   ],
   "source": [
    "# DSCR EXPORT \n",
    "# Self-contained: recomputes every DSCR number from df_yearly_trend_77\n",
    "# directly. Does not depend on variables left over from the Scenario\n",
    "# A/B or heatmap cells above.\n",
    "\n",
    "\n",
    "import pandas as pd\n",
    "\n",
    "df_yr_avg_export = (df_yearly_trend_77\n",
    "                     .groupby('year')['GHI_annual']\n",
    "                     .mean()\n",
    "                     .reset_index()\n",
    "                     .rename(columns={'GHI_annual': 'ghi'}))\n",
    "\n",
    "GHI_P50_E    = df_yr_avg_export['ghi'].mean()\n",
    "GHI_TROUGH_E = df_yr_avg_export[(df_yr_avg_export['year'] >= 2015) &\n",
    "                                 (df_yr_avg_export['year'] <= 2021)]['ghi'].mean()\n",
    "GHI_WORST_E  = df_yr_avg_export[df_yr_avg_export['year'].isin([2020, 2021])]['ghi'].mean()\n",
    "\n",
    "resource_cases_export = [\n",
    "    (\"P50 (2005-2023 mean)\",       GHI_P50_E),\n",
    "    (\"Trough avg (2015-2021)\",     GHI_TROUGH_E),\n",
    "    (\"Worst year (2020-2021 avg)\", GHI_WORST_E),\n",
    "]\n",
    "\n",
    "def dscr_status(d):\n",
    "    if d >= 1.20: return \"OK\"\n",
    "    if d >= 1.00: return \"Below covenant\"\n",
    "    return \"DEFAULT RISK\"\n",
    "\n",
    "def compute_dscr(capex_per_mw, tariff, debt_ratio, interest_rate, loan_term_yrs,\n",
    "                  project_yr, ghi, capacity_mw=10.0, ilr=1.25, perf_ratio=0.82,\n",
    "                  degradation_rate=0.005, opex=0.80):\n",
    "    capex_npr = capacity_mw * capex_per_mw\n",
    "    debt_npr  = capex_npr * debt_ratio\n",
    "    r, n      = interest_rate, loan_term_yrs\n",
    "    annual_ds = debt_npr * (r * (1 + r) ** n) / ((1 + r) ** n - 1)\n",
    "    deg       = (1 - degradation_rate) ** (project_yr - 1)\n",
    "    kwh       = (capacity_mw * ilr) * ghi * perf_ratio * deg * 1000\n",
    "    noi       = kwh * (tariff - opex)\n",
    "    return noi / annual_ds\n",
    "\n",
    "rows = []\n",
    "\n",
    "# Scenario A main table: 2 CAPEX x 3 resource cases x 3 project years = 18 rows\n",
    "for capex in [80_000_000, 85_000_000]:\n",
    "    for proj_yr in [1, 5, 10]:\n",
    "        for g_label, ghi in resource_cases_export:\n",
    "            d = compute_dscr(capex, 7.30, 0.75, 0.09, 12, proj_yr, ghi)\n",
    "            rows.append({\n",
    "                \"scenario_name\": \"Scenario A\", \"capex_per_mw\": capex, \"tariff\": 7.30,\n",
    "                \"debt_ratio\": 0.75, \"interest_rate\": 0.09, \"loan_term_years\": 12,\n",
    "                \"project_year\": proj_yr, \"resource_case\": g_label,\n",
    "                \"ghi_value\": round(ghi, 1), \"dscr_value\": round(d, 3), \"status\": dscr_status(d)\n",
    "            })\n",
    "\n",
    "# Scenario B main table: 4 tariffs x 3 resource cases x 3 project years = 36 rows\n",
    "for tariff in [5.94, 5.55, 5.28, 5.00]:\n",
    "    for proj_yr in [1, 5, 10]:\n",
    "        for g_label, ghi in resource_cases_export:\n",
    "            d = compute_dscr(75_000_000, tariff, 0.75, 0.09, 15, proj_yr, ghi)\n",
    "            rows.append({\n",
    "                \"scenario_name\": \"Scenario B\", \"capex_per_mw\": 75_000_000, \"tariff\": tariff,\n",
    "                \"debt_ratio\": 0.75, \"interest_rate\": 0.09, \"loan_term_years\": 15,\n",
    "                \"project_year\": proj_yr, \"resource_case\": g_label,\n",
    "                \"ghi_value\": round(ghi, 1), \"dscr_value\": round(d, 3), \"status\": dscr_status(d)\n",
    "            })\n",
    "\n",
    "# Scenario A heatmap grid: 5 tariffs x 5 CAPEX, Year 10, trough resource = 25 rows\n",
    "tariff_grid_a = [6.50, 6.90, 7.10, 7.30, 7.50]\n",
    "capex_grid_a  = [75_000_000, 80_000_000, 85_000_000, 90_000_000, 95_000_000]\n",
    "for tariff in tariff_grid_a:\n",
    "    for capex in capex_grid_a:\n",
    "        d = compute_dscr(capex, tariff, 0.75, 0.09, 12, 10, GHI_TROUGH_E)\n",
    "        rows.append({\n",
    "            \"scenario_name\": \"Scenario A - Grid\", \"capex_per_mw\": capex, \"tariff\": tariff,\n",
    "            \"debt_ratio\": 0.75, \"interest_rate\": 0.09, \"loan_term_years\": 12,\n",
    "            \"project_year\": 10, \"resource_case\": \"Trough avg (2015-2021)\",\n",
    "            \"ghi_value\": round(GHI_TROUGH_E, 1), \"dscr_value\": round(d, 3), \"status\": dscr_status(d)\n",
    "        })\n",
    "\n",
    "# Scenario B heatmap grid: 11 tariffs x 6 CAPEX, Year 10, trough resource = 66 rows\n",
    "tariff_grid_b = [round(5.00 + 0.10 * i, 2) for i in range(11)]\n",
    "capex_grid_b  = [60_000_000, 65_000_000, 70_000_000, 75_000_000, 80_000_000, 85_000_000]\n",
    "for tariff in tariff_grid_b:\n",
    "    for capex in capex_grid_b:\n",
    "        d = compute_dscr(capex, tariff, 0.75, 0.09, 15, 10, GHI_TROUGH_E)\n",
    "        rows.append({\n",
    "            \"scenario_name\": \"Scenario B - Grid\", \"capex_per_mw\": capex, \"tariff\": tariff,\n",
    "            \"debt_ratio\": 0.75, \"interest_rate\": 0.09, \"loan_term_years\": 15,\n",
    "            \"project_year\": 10, \"resource_case\": \"Trough avg (2015-2021)\",\n",
    "            \"ghi_value\": round(GHI_TROUGH_E, 1), \"dscr_value\": round(d, 3), \"status\": dscr_status(d)\n",
    "        })\n",
    "\n",
    "df_dscr_export = pd.DataFrame(rows)\n",
    "df_dscr_export.to_csv(\"nepal_dscr_full_77.csv\", index=False)\n",
    "print(f\"Exported {len(df_dscr_export)} rows to nepal_dscr_full_77.csv\")\n",
    "print(df_dscr_export['scenario_name'].value_counts())"
   ]
  },
