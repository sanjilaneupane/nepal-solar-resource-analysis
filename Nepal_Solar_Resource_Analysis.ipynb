    "# ================================================================\n",
    "# BIFACIAL RELEVANCE SCREENING\n",
    "# Screening-level only. Uses the beam fraction, DNI over GHI, to flag which\n",
    "# districts have the clear-sky exposure that would make bifacial modules worth\n",
    "# testing in PVsyst. \n",
    "#\n",
    "# NOTE: Mugu (High Mountain) returns the lowest beam fraction in the\n",
    "# 77-district set (0.825), which runs counter to what altitude and\n",
    "# rain-shadow clear-sky exposure would typically predict for a High\n",
    "# Mountain site. This likely reflects ERA5's ~25km grid cell picking up\n",
    "# terrain or cloud effects that do not represent actual site conditions.\n",
    "# Mugu's figure is reported in the Key Findings and Limitations sections\n",
    "# below, both flagging it as screening-level and unverified pending\n",
    "# independent confirmation. It is not withheld, but should not be\n",
    "# treated as validated without further site-specific work.\n",
    "# ================================================================\n",
    "\n",
    "df_dni_annual = df_monthly_77.groupby(['location', 'zone'])['DNI_monthly'].sum().reset_index()\n",
    "df_dni_annual = df_dni_annual.rename(columns={'DNI_monthly': 'DNI_annual'})\n",
    "df_beam = df_annual_77.merge(df_dni_annual, on=['location', 'zone'])\n",
    "df_beam['beam_fraction'] = df_beam['DNI_annual'] / df_beam['GHI_annual']\n",
    "df_beam = df_beam.sort_values('beam_fraction', ascending=False).reset_index(drop=True)\n",
    "df_beam.to_csv('nepal_beam_fraction_77.csv', index=False)\n",
    "\n",
    "print(\"Beam Fraction (DNI/GHI) by District, top 10 (most direct/clear-sky):\")\n",
    "print(df_beam[['location', 'zone', 'beam_fraction']].head(10).to_string(index=False))\n",
    "print(\"\\nBottom 5 (most diffuse/monsoon-influenced):\")\n",
    "print(df_beam[['location', 'zone', 'beam_fraction']].tail(5).to_string(index=False))\n",
    "\n",
    "bifacial_gains = {\"Monofacial (0%)\": 0.00, \"Bifacial, low (+5%)\": 0.05,\n",
    "                   \"Bifacial, mid (+8%)\": 0.08, \"Bifacial, high (+12%)\": 0.12}\n",
    "\n",
    "def dscr_with_bifacial(ghi, tariff, capex_per_mw, debt_ratio, interest_rate, loan_term, proj_yr, gain,\n",
    "                        capacity_mw=10.0, ilr=1.25, perf_ratio=0.82, degradation=0.005, opex=0.80):\n",
    "    capex_npr = capacity_mw * capex_per_mw\n",
    "    debt_npr  = capex_npr * debt_ratio\n",
    "    r, n      = interest_rate, loan_term\n",
    "    annual_ds = debt_npr * (r * (1 + r)**n) / ((1 + r)**n - 1)\n",
    "    deg = (1 - degradation) ** (proj_yr - 1)\n",
    "    kwh = (capacity_mw * ilr) * ghi * perf_ratio * deg * 1000 * (1 + gain)\n",
    "    noi = kwh * (tariff - opex)\n",
    "    return noi / annual_ds\n",
    "\n",
    "print(\"\\nDSCR Sensitivity to Bifacial Gain | Scenario B basis | Trough resource | Year 10\\n\")\n",
    "for label, gain in bifacial_gains.items():\n",
    "    d = dscr_with_bifacial(GHI_TROUGH_H, 5.94, 75_000_000, 0.75, 0.09, 15, 10, gain)\n",
    "    print(f\"  {label:<24} DSCR: {d:.3f}\")"
   ]
