   "source": [
    "# --- MONTHLY VARIABILITY HEATMAP ---\n",
    "# CoV per district per month across 19 years\n",
    "# Shows which months carry highest inter-annual uncertainty\n",
    "# Relevant for generation planning and seasonal cash flow modelling\n",
    "\n",
    "df_monthly_cov = df_all_77.groupby(['location', 'zone', 'month'])['H(h)_m'].agg(\n",
    "    ghi_mean='mean',\n",
    "    ghi_std='std'\n",
    ").reset_index()\n",
    "\n",
    "df_monthly_cov['cov_pct'] = (df_monthly_cov['ghi_std'] / df_monthly_cov['ghi_mean']) * 100\n",
    "\n",
    "# Pivot for heatmap\n",
    "pivot_cov = df_monthly_cov.pivot_table(\n",
    "    index='location', columns='month', values='cov_pct'\n",
    ")\n",
    "\n",
    "# Order districts by annual GHI\n",
    "district_order = df_annual_77.sort_values('GHI_annual', ascending=False)['location'].tolist()\n",
    "pivot_cov = pivot_cov.reindex(district_order)\n",
    "\n",
    "month_labels = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun',\n",
