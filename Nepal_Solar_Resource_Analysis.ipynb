    "def build_dscr_grid(tariff_grid, capex_grid, debt_ratio, interest_rate, loan_term, ghi, proj_yr,\n",
    "                     degradation_rate=0.005, opex=0.80, ilr=1.25, perf_ratio=0.82, capacity_mw=10.0):\n",
    "    grid = np.zeros((len(tariff_grid), len(capex_grid)))\n",
    "    for i, tariff in enumerate(tariff_grid):\n",
    "        for j, capex_per_mw in enumerate(capex_grid):\n",
    "            capex_npr = capacity_mw * capex_per_mw\n",
    "            debt_npr  = capex_npr * debt_ratio\n",
    "            r, n      = interest_rate, loan_term\n",
    "            annual_ds = debt_npr * (r * (1 + r)**n) / ((1 + r)**n - 1)\n",
    "            deg = (1 - degradation_rate) ** (proj_yr - 1)\n",
    "            kwh = (capacity_mw * ilr) * ghi * perf_ratio * deg * 1000\n",
    "            noi = kwh * (tariff - opex)\n",
    "            grid[i, j] = noi / annual_ds\n",
    "    return grid\n",
    "\n",
    "def plot_dscr_heatmap(grid, tariff_grid, capex_grid, title, filename, covenant=1.20):\n",
    "    fig, ax = plt.subplots(figsize=(10, 7))\n",
    "    sns.heatmap(grid, annot=True, fmt='.3f', cmap='RdYlGn',\n",
    "                xticklabels=[f\"{c/1e6:.0f}M\" for c in capex_grid],\n",
    "                yticklabels=[f\"{t:.2f}\" for t in tariff_grid],\n",
    "                center=covenant, vmin=0.80, vmax=1.60,\n",
    "                cbar_kws={'label': 'DSCR'}, ax=ax)\n",
    "\n",
    "    # Contour line at the covenant boundary\n",
    "    X, Y = np.meshgrid(np.arange(len(capex_grid)) + 0.5,\n",
    "                        np.arange(len(tariff_grid)) + 0.5)\n",
    "    ax.contour(X, Y, grid, levels=[covenant], colors='black', linewidths=2.0)\n",
    "\n",
    "    ax.set_xlabel('CAPEX (NPR/MW)', fontsize=11)\n",
    "    ax.set_ylabel('Tariff (NPR/kWh)', fontsize=11)\n",
    "    ax.set_title(title, fontsize=12, fontweight='bold', pad=12)\n",
    "    plt.tight_layout()\n",
    "    plt.savefig(filename, dpi=150, bbox_inches='tight')\n",
    "    plt.show()\n",
    "    print(f\"Saved {filename}\")\n",
    "\n",
    "df_yr_avg_h = (df_yearly_trend_77.groupby('year')['GHI_annual'].mean()\n",
    "               .reset_index().rename(columns={'GHI_annual': 'ghi'}))\n",
    "GHI_TROUGH_H = df_yr_avg_h[(df_yr_avg_h['year'] >= 2015) & (df_yr_avg_h['year'] <= 2021)]['ghi'].mean()\n",
    "\n",
    "tariff_grid_a = [6.50, 6.90, 7.10, 7.30, 7.50]\n",
    "capex_grid_a  = [75_000_000, 80_000_000, 85_000_000, 90_000_000, 95_000_000]\n",
    "grid_a = build_dscr_grid(tariff_grid_a, capex_grid_a, 0.75, 0.09, 12, GHI_TROUGH_H, proj_yr=10)\n",
    "plot_dscr_heatmap(grid_a, tariff_grid_a, capex_grid_a,\n",
    "                   'Scenario A: DSCR Sensitivity, Tariff x CAPEX\\nYear 10 | Trough-Average Resource (2015-2021)',\n",
    "                   'chart7a_dscr_heatmap_scenario_a.png')\n",
    "\n",
    "tariff_grid_b = [round(t, 2) for t in np.arange(5.00, 6.05, 0.10)]\n",
    "capex_grid_b  = [60_000_000, 65_000_000, 70_000_000, 75_000_000, 80_000_000, 85_000_000]\n",
    "grid_b = build_dscr_grid(tariff_grid_b, capex_grid_b, 0.75, 0.09, 15, GHI_TROUGH_H, proj_yr=10)\n",
    "plot_dscr_heatmap(grid_b, tariff_grid_b, capex_grid_b,\n",
    "                   'Scenario B: DSCR Sensitivity, Tariff x CAPEX\\nYear 10 | Trough-Average Resource (2015-2021)',\n",
    "                   'chart7b_dscr_heatmap_scenario_b.png')\n",
    "n_clear_a = (grid_a >= DSCR_COVENANT).sum()\n",
    "n_total_a = grid_a.size\n",
    "print(f\"Scenario A: {n_clear_a} of {n_total_a} tariff-CAPEX combinations clear {DSCR_COVENANT}x covenant\")\n",
    "\n",
    "n_clear_b = (grid_b >= DSCR_COVENANT).sum()\n",
    "n_total_b = grid_b.size\n",
    "print(f\"Scenario B: {n_clear_b} of {n_total_b} tariff-CAPEX combinations clear {DSCR_COVENANT}x covenant\")\n",
    "\n",
    "n_default_b = (grid_b < DSCR_DEFAULT).sum()\n",
    "print(f\"Scenario B: {n_default_b} of {n_total_b} combinations in default-risk territory (DSCR < {DSCR_DEFAULT}x)\")"
   ]
