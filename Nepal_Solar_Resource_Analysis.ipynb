    "from scipy import stats as sp_stats\n",
    "\n",
    "# --- P50 / P75 / P90 / P99 EXCEEDANCE ESTIMATES PER DISTRICT (Phase 2b) ---\n",
    "# P50 = median expected annual GHI (50% probability of exceedance)\n",
    "# P75 = annual GHI exceeded in 3 out of 4 years\n",
    "# P90 = annual GHI exceeded in 9 out of 10 years (lender conservative case)\n",
    "# P99 = annual GHI exceeded in 99 out of 100 years (extreme downside)\n",
    "# Method: assumes normal distribution of annual GHI\n",
    "\n",
    "df_p90_77 = df_yearly_trend_77.groupby(['location', 'zone'])['GHI_annual'].agg(\n",
    "    ghi_mean='mean',\n",
    "    ghi_std='std',\n",
    "    ghi_count='count'\n",
    ").reset_index()\n",
    "\n",
    "# P-values\n",
    "df_p90_77['P50']           = df_p90_77['ghi_mean']\n",
    "df_p90_77['P75']           = df_p90_77['ghi_mean'] - 0.674 * df_p90_77['ghi_std']\n",
    "df_p90_77['P90']           = df_p90_77['ghi_mean'] - 1.282 * df_p90_77['ghi_std']\n",
    "df_p90_77['P99']           = df_p90_77['ghi_mean'] - 2.326 * df_p90_77['ghi_std']\n",
    "df_p90_77['P90_P50_ratio'] = df_p90_77['P90'] / df_p90_77['P50']\n",
    "df_p90_77['P99_P50_ratio'] = df_p90_77['P99'] / df_p90_77['P50']\n",
    "\n",
    "df_p90_77 = df_p90_77.sort_values('P90_P50_ratio', ascending=True).reset_index(drop=True)\n",
    "\n",
    "print(\"P50/P75/P90/P99 Exceedance Estimates by District - Phase 2b (2005–2023)\")\n",
    "print(\"Assumes normal distribution of annual GHI | Based on 19-year record\")\n",
    "print(f\"\\n{'District':<20} {'Zone':<22} {'P50':>7} {'P75':>7} {'P90':>7} {'P99':>7} {'P90/P50':>9}\")\n",
    "print(\"-\" * 80)\n",
    "for _, row in df_p90_77.iterrows():\n",
    "    print(f\"{row['location']:<20} {row['zone']:<22} {row['P50']:>7.0f} \"\n",
    "          f\"{row['P75']:>7.0f} {row['P90']:>7.0f} {row['P99']:>7.0f} \"\n",
    "          f\"{row['P90_P50_ratio']:>9.3f}\")\n",
    "\n",
    "print(f\"\\nAverage P90/P50 ratio: {df_p90_77['P90_P50_ratio'].mean():.3f}\")\n",
    "print(f\"Average P99/P50 ratio: {df_p90_77['P99_P50_ratio'].mean():.3f}\")\n",
    "print(f\"\\nLowest P90/P50 (highest risk): {df_p90_77['P90_P50_ratio'].min():.3f} \"\n",
    "      f\" -  {df_p90_77.iloc[0]['location']}\")\n",
    "print(f\"Highest P90/P50 (lowest risk): {df_p90_77['P90_P50_ratio'].max():.3f} \"\n",
    "      f\" -  {df_p90_77.iloc[-1]['location']}\")\n",
    "print(f\"\\nLowest P99/P50 (extreme downside): {df_p90_77['P99_P50_ratio'].min():.3f} \"\n",
    "      f\" -  {df_p90_77.sort_values('P99_P50_ratio').iloc[0]['location']}\")"
   ]
