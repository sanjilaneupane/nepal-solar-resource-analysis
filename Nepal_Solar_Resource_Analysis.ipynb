   "source": [
    "fig, axes = plt.subplots(1, 2, figsize=(16, 7))\n",
    "\n",
    "df_zone_trend_77 = df_yearly_trend_77.groupby(['zone', 'year'])['GHI_annual'].mean().reset_index()\n",
    "\n",
    "ax1 = axes[0]\n",
    "for zone in sorted(df_zone_trend_77['zone'].unique()):\n",
    "    color = zone_colors_77[zone]\n",
    "    for loc in df_yearly_trend_77[df_yearly_trend_77['zone'] == zone]['location'].unique():\n",
    "        df_loc = df_yearly_trend_77[df_yearly_trend_77['location'] == loc]\n",
    "        ax1.plot(df_loc['year'], df_loc['GHI_annual'],\n",
    "                 color=color, alpha=0.10, linewidth=0.8)\n",
    "    df_z = df_zone_trend_77[df_zone_trend_77['zone'] == zone]\n",
    "    n_per_zone = df_yearly_trend_77.groupby('zone')['location'].nunique()\n",
    "    n = n_per_zone[zone]\n",
    "    ax1.plot(df_z['year'], df_z['GHI_annual'],\n",
    "         color=color, linewidth=2.5, marker='o', markersize=5,\n",
    "         label=f\"{zone} (n={n})\", alpha=0.95)\n",
    "\n",
    "ax1.set_title('Annual GHI Trend by Zone (2005–2023)\\nBold = zone average | Faint = individual districts',\n",
    "              fontsize=11, fontweight='bold', pad=12)\n",
    "ax1.set_xlabel('Year', fontsize=10)\n",
    "ax1.set_ylabel('Annual GHI (kWh/m²)', fontsize=10)\n",
    "ax1.legend(fontsize=8, loc='lower left', framealpha=0.9)\n",
    "ax1.grid(True, alpha=0.3)\n",
    "ax1.set_xticks(range(2005, 2024, 2))\n",
    "ax1.spines['top'].set_visible(False)\n",
    "ax1.spines['right'].set_visible(False)\n",
    "\n",
    "ax2 = axes[1]\n",
    "for zone in sorted(df_zone_trend_77['zone'].unique()):\n",
    "    df_z = df_zone_trend_77[df_zone_trend_77['zone'] == zone].copy()\n",
    "    n_per_zone = df_yearly_trend_77.groupby('zone')['location'].nunique()\n",
    "    color = zone_colors_77[zone]\n",
    "    baseline = df_z[df_z['year'] == 2005]['GHI_annual'].values[0]\n",
    "    df_z['pct_change'] = ((df_z['GHI_annual'] - baseline) / baseline) * 100\n",
