    "for bar, val in zip(bars, df_plot_77['GHI_annual']):\n",
    "    ax.text(bar.get_width() + 6, bar.get_y() + bar.get_height() / 2,\n",
    "            f'{val:.0f}', va='center', ha='left', fontsize=8, color='#333333')\n",
    "\n",
    "avg_ghi_77 = df_annual_77['GHI_annual'].mean()\n",
    "ax.axvline(x=avg_ghi_77, color='black', linestyle='--', linewidth=1.2, alpha=0.6)\n",
    "ax.text(avg_ghi_77 + 2, 0.5, f'Avg: {avg_ghi_77:.0f}', fontsize=9, color='black', alpha=0.7)\n",
