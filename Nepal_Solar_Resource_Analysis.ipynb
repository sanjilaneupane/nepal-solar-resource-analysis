   "source": [
    "# --- TROUGH DURATION RISK SCORING ---\n",
    "# For each district, identify years where GHI fell below 95% of long-run mean\n",
    "# Count total years below threshold and maximum consecutive years below threshold\n",
    "# This quantifies sustained underperformance risk within a debt term\n",
    "\n",
    "threshold_pct = 0.95\n",
    "\n",
    "def max_consecutive_below(series):\n",
    "    max_run = 0\n",
    "    current_run = 0\n",
    "    for val in series:\n",
    "        if val:\n",
    "            current_run += 1\n",
    "            max_run = max(max_run, current_run)\n",
    "        else:\n",
    "            current_run = 0\n",
    "    return max_run\n",
    "\n",
    "trough_data = []\n",
    "\n",
    "for location in df_yearly_trend_77['location'].unique():\n",
    "    df_loc = df_yearly_trend_77[df_yearly_trend_77['location'] == location].copy()\n",
    "    zone = df_loc['zone'].values[0]\n",
    "    ghi_mean = df_loc['GHI_annual'].mean()\n",
    "    threshold = ghi_mean * threshold_pct\n",
    "    \n",
    "    df_loc['below_threshold'] = df_loc['GHI_annual'] < threshold\n",
    "    \n",
    "    years_below = df_loc['below_threshold'].sum()\n",
    "    max_consec = max_consecutive_below(df_loc['below_threshold'].tolist())\n",
    "    \n",
    "    # Trough window identification\n",
    "    trough_years = df_loc[df_loc['below_threshold']]['year'].tolist()\n",
    "    trough_start = min(trough_years) if trough_years else None\n",
    "    trough_end = max(trough_years) if trough_years else None\n",
    "    \n",
    "    # Risk tier based on max consecutive years\n",
    "    if max_consec >= 5:\n",
    "        risk_tier = \"High\"\n",
    "    elif max_consec >= 3:\n",
    "        risk_tier = \"Moderate\"\n",
    "    else:\n",
    "        risk_tier = \"Low\"\n",
    "    \n",
    "    trough_data.append({\n",
    "        'district':           location,\n",
    "        'zone':               zone,\n",
    "        'ghi_mean':           round(ghi_mean, 1),\n",
    "        'years_below_95pct':  int(years_below),\n",
    "        'max_consecutive':    int(max_consec),\n",
    "        'trough_start':       trough_start,\n",
    "        'trough_end':         trough_end,\n",
    "        'risk_tier':          risk_tier,\n",
    "    })\n",
    "\n",
    "df_trough = pd.DataFrame(trough_data).sort_values(\n",
    "    ['max_consecutive', 'years_below_95pct'], ascending=False\n",
    ").reset_index(drop=True)\n",
    "\n",
    "df_trough.to_csv('nepal_ghi_trough_risk_77.csv', index=False)\n",
    "\n",
    "print(\"Trough Duration Risk Scoring - 77 Districts (threshold: 95% of long-run mean)\")\n",
    "print(f\"\\n{'District':<20} {'Zone':<22} {'Yrs Below':>10} {'Max Consec':>11} {'Risk':>8}\")\n",
    "print(\"-\" * 76)\n",
    "for _, row in df_trough.iterrows():\n",
    "    print(f\"{row['district']:<20} {row['zone']:<22} \"\n",
    "          f\"{row['years_below_95pct']:>10} {row['max_consecutive']:>11} \"\n",
    "          f\"{row['risk_tier']:>8}\")\n",
    "\n",
    "print(f\"\\nRisk tier summary:\")\n",
    "print(df_trough['risk_tier'].value_counts().to_string())\n",
    "print(f\"\\nDistricts with 5+ consecutive years below 95% threshold:\")\n",
    "high_risk = df_trough[df_trough['risk_tier'] == 'High']\n",
    "print(high_risk[['district', 'zone', 'max_consecutive', 'trough_start', 'trough_end']].to_string(index=False))"
